# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# Sarvam API key (https://indus.sarvam.ai -> API keys), used for speech, voice, questions and marking.
SARVAM_API_KEY=your-key-here

# Optional: the live Exam Buddy voice agent built in Sarvam Indus (Voice Agents -> Deploy with Code).
# INDUS_APP_ID is the agent ID (the part after /update-agent/ in the agent editor's address).
# INDUS_API_KEY is the Voice Agents key ("Generate API key"); it stays on the server.
INDUS_APP_ID=
INDUS_ORG_ID=
INDUS_WORKSPACE_ID=
INDUS_API_KEY=
